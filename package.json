{
  "name": "nook",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:newman": "node tests/postman/run.mjs",
    "e2e:build": "pnpm --filter @nook/api db:generate && pnpm --filter @nook/api build && VITE_COVERAGE=true pnpm --filter @nook/web exec vite build --outDir dist-e2e --emptyOutDir",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "e2e:report": "nyc report --reporter=html --reporter=text-summary --reporter=json-summary",
    "e2e:coverage": "pnpm e2e && pnpm e2e:report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@prisma/adapter-pg": "7.10.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jose": "^6.2.14",
    "newman": "^6.2.3",
    "nyc": "18.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
