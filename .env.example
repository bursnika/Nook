# Copy to apps/api/.env for local development
DATABASE_URL="postgresql://nook:nook@localhost:5433/nook?schema=public"
PORT=3000
UPLOAD_DIR=uploads

# Google OAuth: create a "Web application" client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Auth: sign access tokens with a long random value, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Comma-separated e-mails of platform admins (can see every workspace and the full user list)
ADMIN_EMAILS=

# Optional: cache GET lists in Redis (docker compose -f infra/docker-compose.yml up -d redis). Empty = in-memory cache
# REDIS_URL=redis://localhost:6380
REDIS_URL=
# Optional: store uploads in Azure Blob Storage instead of UPLOAD_DIR (private container, created on first start)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=nook-uploads

# Optional: AI planning assistant (Pro). Key from https://console.anthropic.com/settings/keys; without it the assistant answers 503
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: RabbitMQ for reminders and Google sync jobs (docs/b8-queues.md). Without it an in-process queue is used.
# Local broker from infra/docker-compose.yml: amqp://nook:nook@localhost:5673
AMQP_URL=
# A task due within this many minutes gets a Telegram reminder; Google accounts are synced every N minutes (0 = off)
REMINDER_LEAD_MINUTES=30
GOOGLE_SYNC_EVERY_MINUTES=30
