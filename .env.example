# copy to apps/api/.env
DATABASE_URL="postgresql://nook:nook@localhost:5433/nook?schema=public"
PORT=3000
UPLOAD_DIR=uploads

# google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# required
JWT_SECRET=
# comma-separated emails
ADMIN_EMAILS=

# optional, e.g. redis://localhost:6380
REDIS_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=nook-uploads

# optional, e.g. amqp://nook:nook@localhost:5673
AMQP_URL=
# 0 = off
GOOGLE_SYNC_EVERY_MINUTES=30
