# Copy to infra/.env (gitignored). Docker Compose reads it automatically.

# Required. Long random value used to sign access tokens:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated e-mails of platform admins (see every workspace and the full user list)
ADMIN_EMAILS=

# Optional: Google sign-in. Create a "Web application" OAuth client and add the callback URL below
# as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Set to true when the stack is served over HTTPS
COOKIE_SECURE=false
