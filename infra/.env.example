# Copy to infra/.env (gitignored). Docker Compose reads it automatically.

# Required. Long random value used to sign access tokens:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated e-mails of platform admins (see every workspace and the full user list)
ADMIN_EMAILS=

# Optional: Google sign-in. Create a "Web application" OAuth client and add the callback URL below
# as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Set to true when the stack is served over HTTPS
COOKIE_SECURE=false

# Public address of the site (canonical links and sitemap of published pages)
PUBLIC_URL=http://localhost:3000

# Optional: Google Analytics 4 measurement id (G-XXXXXXXXXX)
GA_MEASUREMENT_ID=

# Redis (list cache) is part of the compose stack and wired to the API automatically (REDIS_URL=redis://redis:6379).
# Without REDIS_URL the API caches in its own memory. See docs/b9-caching.md

# RabbitMQ (Google sync jobs) is part of the compose stack and wired to the API automatically
# (AMQP_URL=amqp://nook:<password>@rabbitmq:5672). In compose.prod.yml the broker password is RABBITMQ_PASSWORD,
# or POSTGRES_PASSWORD when unset; it is only applied when the broker's volume is created. Without AMQP_URL the
# API uses an in-process queue (nothing survives a restart). See docs/b8-queues.md
RABBITMQ_PASSWORD=
# How often every connected Google account is synced in the background; 0 switches it off
GOOGLE_SYNC_EVERY_MINUTES=30

# Optional: keep uploaded files in Azure Blob Storage (a private container, created on first start).
# Without the connection string they stay on the uploads volume. See docs/c19-blob-storage.md
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=nook-uploads
