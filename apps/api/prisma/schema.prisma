generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum BlockType {
  PARAGRAPH
  HEADING_1
  HEADING_2
  HEADING_3
  BULLETED_LIST
  NUMBERED_LIST
  TODO
  QUOTE
  CODE
  DIVIDER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id              String   @id @default(uuid(7))
  email           String   @unique
  name            String
  avatarUrl       String?
  // Google account id (the OIDC `sub`); set on first sign-in with Google.
  googleId        String?  @unique
  // SHA-256 of the personal token that lets a home-screen widget read today's plan (the token itself is shown once).
  widgetTokenHash String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     Membership[]
  authoredPages   Page[]            @relation("PageAuthor")
  assignedTasks   Task[]            @relation("TaskAssignee")
  refreshTokens   RefreshToken[]
  sentInvitations Invitation[]      @relation("InvitedBy")
  importedEvents  CalendarEvent[]   @relation("EventImporter")
  importedTasks   Task[]            @relation("TaskImporter")
  googleCalendar  GoogleConnection?
  telegram        TelegramLink?

  @@index([name])
  // Trigram indexes for fast substring search (created by the user_search_indexes migration).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm_idx")
}

/// A person's link to their Google Calendar. The refresh token is stored encrypted (see google-calendar/token-crypto.ts).
model GoogleConnection {
  id              String    @id @default(uuid(7))
  userId          String    @unique
  refreshTokenEnc String
  scope           String
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String   @id @default(uuid(7))
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  pages       Page[]
  tasks       Task[]
  events      CalendarEvent[]
  attachments Attachment[]
  invitations Invitation[]
}

model Membership {
  id          String   @id @default(uuid(7))
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())
  userId      String
  workspaceId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Page {
  id          String   @id @default(uuid(7))
  title       String
  icon        String?
  // Link to an uploaded cover image (the "file" field required by the MVC task).
  coverUrl    String?
  // Public landing page address: /p/:slug. Null while the page is private.
  slug        String?  @unique
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspaceId String
  authorId    String
  parentId    String?

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User         @relation("PageAuthor", fields: [authorId], references: [id])
  parent      Page?        @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Page[]       @relation("PageTree")
  blocks      Block[]
  ops         PageOp[]
  tasks       Task[]
  attachments Attachment[]

  @@index([workspaceId, parentId])
  @@index([title])
}

model Block {
  id        String    @id @default(uuid(7))
  type      BlockType @default(PARAGRAPH)
  content   Json      @default("{}")
  // Fractional position inside the page: a new block goes between its neighbours.
  position  Float
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  pageId    String

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, position])
}

// A Telegram chat that gets this person's morning plan and answers /today.
model TelegramLink {
  id           String   @id @default(uuid(7))
  userId       String   @unique
  chatId       String   @unique
  // The day (YYYY-MM-DD, UTC) the morning plan was last sent, so it goes out once a day.
  lastDigestOn String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One entry per batch of block operations applied to a page. `seq` orders the log, so a client that was
// offline (or polling) asks for everything after the last `seq` it has seen.
model PageOp {
  seq         Int      @id @default(autoincrement())
  pageId      String
  workspaceId String
  authorId    String
  // Who sent it: lets a browser tab tell its own echo from other people's changes.
  clientId    String
  ops         Json
  createdAt   DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, seq])
}

model Task {
  id           String       @id @default(uuid(7))
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?
  // Order inside a Kanban column.
  position     Float        @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  completedAt  DateTime?
  workspaceId  String
  pageId       String?
  assigneeId   String?
  // Set when the task was imported from Google Tasks (`<list id>/<task id>`) by this person.
  googleTaskId String?
  importedById String?

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page       Page?           @relation(fields: [pageId], references: [id], onDelete: SetNull)
  assignee   User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events     CalendarEvent[]
  importedBy User?           @relation("TaskImporter", fields: [importedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, googleTaskId])
  @@index([importedById])
  @@index([workspaceId, status, position])
  @@index([workspaceId, dueDate])
  @@index([assigneeId])
}

model CalendarEvent {
  id               String   @id @default(uuid(7))
  title            String
  description      String?
  startsAt         DateTime
  endsAt           DateTime
  allDay           Boolean  @default(false)
  // Set when the event was imported from Google Calendar.
  googleEventId    String?
  // Whose Google Calendar it came from; only that person's sync may remove it again.
  importedById     String?
  // Which of their calendars (primary, holidays, a shared one, ...) and what it is called.
  googleCalendarId String?
  calendarName     String?
  // Whether the person may change it in Google (writer/owner of the calendar, not a birthday etc.).
  googleEditable   Boolean  @default(false)
  // One occurrence of a repeating event: edits apply to this occurrence only.
  recurring        Boolean  @default(false)
  googleUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  workspaceId      String
  taskId           String?

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  importedBy User?     @relation("EventImporter", fields: [importedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, googleEventId])
  @@index([workspaceId, startsAt])
  @@index([importedById])
}

model Attachment {
  id          String   @id @default(uuid(7))
  filename    String
  // Link to the stored file (local uploads now, blob storage later).
  url         String
  mimeType    String
  size        Int
  createdAt   DateTime @default(now())
  workspaceId String
  pageId      String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page      Page?     @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([pageId])
}

/// Long-lived session token. Only a hash is stored; every use rotates it, and reusing a rotated one revokes the user's sessions.
model RefreshToken {
  id        String    @id @default(uuid(7))
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Invites a person (by e-mail) to a workspace. The secret token is shown once; only its hash is stored.
model Invitation {
  id          String    @id @default(uuid(7))
  email       String
  role        Role      @default(MEMBER)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspaceId String
  invitedById String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

/// A feature is available when it is enabled and the workspace plan is at least `minPlan`.
model FeatureFlag {
  key         String  @id
  description String
  minPlan     Plan    @default(PRO)
  enabled     Boolean @default(true)
}
