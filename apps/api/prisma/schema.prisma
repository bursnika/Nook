generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum BlockType {
  PARAGRAPH
  HEADING_1
  HEADING_2
  HEADING_3
  BULLETED_LIST
  NUMBERED_LIST
  TODO
  QUOTE
  CODE
  DIVIDER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id              String   @id @default(uuid(7))
  email           String   @unique
  name            String
  avatarUrl       String?
  googleId        String?  @unique
  // sha-256 of the widget token
  widgetTokenHash String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     Membership[]
  authoredPages   Page[]            @relation("PageAuthor")
  assignedTasks   Task[]            @relation("TaskAssignee")
  refreshTokens   RefreshToken[]
  sentInvitations Invitation[]      @relation("InvitedBy")
  importedEvents  CalendarEvent[]   @relation("EventImporter")
  importedTasks   Task[]            @relation("TaskImporter")
  googleCalendar  GoogleConnection?
  taskComments    TaskComment[]

  @@index([name])
  // trigram indexes for substring search
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm_idx")
}

model GoogleConnection {
  id              String    @id @default(uuid(7))
  userId          String    @unique
  refreshTokenEnc String
  scope           String
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String   @id @default(uuid(7))
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  pages       Page[]
  tasks       Task[]
  events      CalendarEvent[]
  attachments Attachment[]
  invitations Invitation[]
}

model Membership {
  id          String   @id @default(uuid(7))
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())
  userId      String
  workspaceId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Page {
  id          String   @id @default(uuid(7))
  title       String
  icon        String?
  coverUrl    String?
  slug        String?  @unique
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspaceId String
  authorId    String
  parentId    String?

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User         @relation("PageAuthor", fields: [authorId], references: [id])
  parent      Page?        @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Page[]       @relation("PageTree")
  blocks      Block[]
  ops         PageOp[]
  tasks       Task[]
  attachments Attachment[]

  @@index([workspaceId, parentId])
  @@index([title])
}

model Block {
  id        String    @id @default(uuid(7))
  type      BlockType @default(PARAGRAPH)
  content   Json      @default("{}")
  position  Float
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  pageId    String

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, position])
}

// change log, clients ask for everything after the last seq
model PageOp {
  seq         Int      @id @default(autoincrement())
  pageId      String
  workspaceId String
  authorId    String
  clientId    String
  ops         Json
  createdAt   DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, seq])
}

model Task {
  id             String       @id @default(uuid(7))
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  position       Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  completedAt    DateTime?
  workspaceId    String
  pageId         String?
  assigneeId     String?
  googleTaskId   String?
  importedById   String?

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page       Page?           @relation(fields: [pageId], references: [id], onDelete: SetNull)
  assignee   User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events     CalendarEvent[]
  importedBy User?           @relation("TaskImporter", fields: [importedById], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  attachments Attachment[]

  @@unique([workspaceId, googleTaskId])
  @@index([importedById])
  @@index([workspaceId, status, position])
  @@index([workspaceId, dueDate])
  @@index([assigneeId])
}

model TaskComment {
  id        String   @id @default(uuid(7))
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taskId    String
  authorId  String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([authorId])
}

model CalendarEvent {
  id               String   @id @default(uuid(7))
  title            String
  description      String?
  startsAt         DateTime
  endsAt           DateTime
  allDay           Boolean  @default(false)
  googleEventId    String?
  importedById     String?
  googleCalendarId String?
  calendarName     String?
  googleEditable   Boolean  @default(false)
  recurring        Boolean  @default(false)
  googleUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  workspaceId      String
  taskId           String?

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  importedBy User?     @relation("EventImporter", fields: [importedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, googleEventId])
  @@index([workspaceId, startsAt])
  @@index([importedById])
}

model Attachment {
  id          String   @id @default(uuid(7))
  filename    String
  url         String
  mimeType    String
  size        Int
  createdAt   DateTime @default(now())
  workspaceId String
  pageId      String?
  taskId      String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page      Page?     @relation(fields: [pageId], references: [id], onDelete: SetNull)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([pageId])
  @@index([taskId])
}

// only a hash is stored, rotated on every use
model RefreshToken {
  id        String    @id @default(uuid(7))
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id          String    @id @default(uuid(7))
  email       String
  role        Role      @default(MEMBER)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspaceId String
  invitedById String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

model FeatureFlag {
  key         String  @id
  description String
  enabled     Boolean @default(true)
}
