<h1 class="mb-3">{{title}}</h1>
<form class="form-frame" method="post" action="{{action}}" novalidate>
  {{> field-text name="name" label="Name" value=form.name error=errors.name required=true maxlength=40}}
  {{> field-text name="color" type="color" label="Colour" value=form.color error=errors.color}}
  <div class="d-flex gap-2">
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-link" href="/admin/workspaces/{{ws.id}}/tags">Cancel</a>
  </div>
</form>
