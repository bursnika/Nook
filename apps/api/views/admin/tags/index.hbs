<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Tags</h1>
  <a class="btn btn-primary" href="/admin/workspaces/{{ws.id}}/tags/new">+ New tag</a>
</div>
{{> search-form q=q placeholder="Search by name…"}}
<div class="table-frame">
  <table class="table table-hover align-middle">
    <thead><tr><th>Name</th><th>Colour</th><th>Tasks</th><th></th></tr></thead>
    <tbody>
      {{#each tags}}
        <tr>
          <td><span class="tag-dot" style="background: {{color}}"></span>{{name}}</td>
          <td><code>{{color}}</code></td>
          <td>{{_count.tasks}}</td>
          <td class="text-end">
            <a class="btn btn-sm btn-outline-primary" href="/admin/workspaces/{{../ws.id}}/tags/{{id}}/edit">Edit</a>
            <form class="d-inline" method="post" action="/admin/workspaces/{{../ws.id}}/tags/{{id}}/delete" data-confirm="Delete tag “{{name}}”? Tasks keep existing without it.">
              <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      {{else}}
        <tr><td colspan="4" class="text-muted p-4">No tags found.</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{> pagination}}
