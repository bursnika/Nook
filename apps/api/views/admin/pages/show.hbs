<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
  <div>
    <h1 class="mb-1">{{#if page.icon}}{{page.icon}} {{/if}}{{page.title}}</h1>
    {{#if page.isPublished}}<span class="chip chip-done">published · /p/{{page.slug}}</span>{{else}}<span class="text-muted">private</span>{{/if}}
  </div>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-primary" href="/admin/workspaces/{{ws.id}}/pages/{{page.id}}/edit">Edit</a>
    <form method="post" action="/admin/workspaces/{{ws.id}}/pages/{{page.id}}/delete" data-confirm="Delete this page and its subpages?">
      <button class="btn btn-outline-danger" type="submit">Delete</button>
    </form>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-4">
    {{#if page.coverUrl}}<img class="cover-preview mb-3" src="{{page.coverUrl}}" alt="Cover of {{page.title}}">{{/if}}
    <div class="card p-3">
      <dl class="mb-0">
        <dt>Author</dt><dd>{{page.author.name}}<br><small class="text-muted">{{page.author.email}}</small></dd>
        <dt>Parent</dt><dd>{{#if page.parent}}<a href="/admin/workspaces/{{ws.id}}/pages/{{page.parent.id}}">{{page.parent.title}}</a>{{else}}<span class="text-muted">top level</span>{{/if}}</dd>
        <dt>Created</dt><dd>{{datetime page.createdAt}}</dd>
        <dt>Updated</dt><dd class="mb-0">{{datetime page.updatedAt}}</dd>
      </dl>
    </div>
  </div>
  <div class="col-lg-8">
    <h2 class="h5">Note</h2>
    <div class="card p-3 mb-3 note-body">
      {{#each page.blocks}}
        {{#if (eq type "TODO")}}
          <p class="mb-1"><input class="form-check-input me-2" type="checkbox" disabled{{#if content.checked}} checked{{/if}} aria-label="Done"> {{content.text}}</p>
        {{else}}
          <p class="mb-1">{{content.text}}</p>
        {{/if}}
      {{else}}
        <p class="text-muted mb-0">The note is empty. Write something below.</p>
      {{/each}}
    </div>
    <form class="mb-4" method="post" action="/admin/workspaces/{{ws.id}}/pages/{{page.id}}/note">
      <label class="form-label fw-bold" for="append-text">Add to this note</label>
      <textarea class="form-control mb-2" id="append-text" name="text" rows="3" maxlength="20000" required placeholder="Write a line or several, one per row."></textarea>
      <button class="btn btn-primary" type="submit">Add</button>
    </form>

    <h2 class="h5">Tasks on this page <small class="text-muted">({{tasksTotal}})</small></h2>
    <form class="quick-task mb-2" method="post" action="/admin/workspaces/{{ws.id}}/tasks">
      <input type="hidden" name="from" value="page">
      <input type="hidden" name="pageId" value="{{page.id}}">
      <input class="form-control" type="text" name="title" maxlength="200" required placeholder="New task for this page…" aria-label="Task title">
      <input class="form-control" type="date" name="dueDate" aria-label="Due date">
      <select class="form-select" name="priority" aria-label="Priority">
        <option value="LOW">Low</option>
        <option value="MEDIUM" selected>Medium</option>
        <option value="HIGH">High</option>
      </select>
      <button class="btn btn-primary" type="submit">+ Add task</button>
    </form>
    {{> task-list tasks=tasks empty="No tasks linked to this page yet." wsId=ws.id}}

    <h2 class="h5 mt-4">Files <small class="text-muted">({{page.attachments.length}})</small></h2>
    <p class="small text-muted">Documents or images that belong to this page.</p>
    <ul>
      {{#each page.attachments}}
        <li><a href="/admin/workspaces/{{../ws.id}}/attachments/{{id}}">{{filename}}</a> <small class="text-muted">{{filesize size}}</small></li>
      {{else}}
        <li class="text-muted">No files.</li>
      {{/each}}
    </ul>
    <a class="btn btn-sm btn-outline-primary" href="/admin/workspaces/{{ws.id}}/attachments/new">Upload a file</a>
  </div>
</div>
