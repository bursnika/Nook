<h1 class="mb-3">{{title}}</h1>
<form class="form-frame" method="post" action="{{action}}" enctype="multipart/form-data" novalidate>
  {{> field-text name="title" label="Title" value=form.title error=errors.title required=true maxlength=200}}
  {{> field-text name="icon" label="Icon" value=form.icon error=errors.icon maxlength=16 hint="One emoji or a short symbol, e.g. ♡"}}
  {{#if isNew}}
    {{> field-ajax name="authorId" label="Author" src=(concat "/admin/workspaces/" ws.id "/lookup/members") minLength=1 placeholder="Pick a workspace member…" selected=authors error=errors.authorId required=true hint="Only members of this workspace can author pages."}}
  {{/if}}
  {{> field-ajax name="parentId" label="Parent page" src=(concat "/admin/workspaces/" ws.id "/lookup/pages") minLength=1 placeholder="Top level (no parent)" selected=parents error=errors.parentId}}
  {{> field-text name="slug" label="Public slug" value=form.slug error=errors.slug maxlength=80 hint="Required to publish. The page is then served at /p/<slug>."}}
  {{> field-checkbox name="isPublished" label="Published (visible to everyone with the link)" checked=form.isPublished error=errors.isPublished}}

  {{#if coverUrl}}
    <div class="mb-3">
      <div class="form-label">Current cover</div>
      <img class="cover-preview d-block mb-2" src="{{coverUrl}}" alt="Current cover">
      {{> field-checkbox name="removeCover" label="Remove the cover"}}
    </div>
  {{/if}}
  {{> field-file name="cover" label=(coverLabel coverUrl) accept="image/png,image/jpeg,image/gif,image/webp" error=errors.cover hint="PNG, JPEG, GIF or WebP, up to 10 MB."}}

  <div class="d-flex gap-2">
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-link" href="/admin/workspaces/{{ws.id}}/pages">Cancel</a>
  </div>
</form>
