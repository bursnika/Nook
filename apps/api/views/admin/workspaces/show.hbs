<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
  <div>
    <h1 class="mb-1">{{ws.name}}</h1>
    <span class="text-muted">{{ws.slug}}</span> · <span class="chip chip-{{lower ws.plan}}">{{ws.plan}}</span>
  </div>
  <a class="btn btn-outline-primary" href="/admin/workspaces/{{ws.id}}/team">Team &amp; plan</a>
</div>

<div class="row g-3 mb-3">
  <div class="col-lg-8">
    <section class="card p-3 h-100" id="calendar" data-workspace="{{ws.id}}" aria-labelledby="calendar-title">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <h2 class="h5 mb-0" id="calendar-title">Calendar</h2>
        <div class="d-flex align-items-center gap-2">
          <button class="btn btn-sm btn-outline-primary" type="button" data-cal="prev" aria-label="Previous month">‹</button>
          <strong class="cal-month" data-cal="label" aria-live="polite"></strong>
          <button class="btn btn-sm btn-outline-primary" type="button" data-cal="next" aria-label="Next month">›</button>
          <button class="btn btn-sm btn-outline-primary" type="button" data-cal="today">Today</button>
        </div>
      </div>
      {{> google-calendar-bar}}
      <div class="cal-grid" data-cal="grid"><noscript>The calendar needs JavaScript.</noscript></div>
      <div class="cal-agenda mt-3" data-cal="agenda" aria-live="polite"></div>
    </section>
  </div>
  <div class="col-lg-4 d-flex flex-column gap-3">
    <section class="card p-3" aria-labelledby="due-soon-title">
      <h2 class="h5" id="due-soon-title">Coming up in the next {{summary.dueSoonHours}} hours</h2>
      {{#if summary.upcomingEvents.length}}
        <ul class="task-list list-unstyled mb-0">
          {{#each summary.upcomingEvents}}
            <li class="task-row">
              <span class="task-title">{{title}}</span>
              <span class="task-meta">
                <span class="chip chip-medium">event</span>
                {{#if isRunning}}<span class="chip chip-done">now</span>{{/if}}
                <time class="local-time" datetime="{{iso startsAt}}">{{datetime startsAt}} UTC</time>
              </span>
            </li>
          {{/each}}
        </ul>
      {{/if}}
      {{#if summary.dueSoon.length}}
        {{> task-list tasks=summary.dueSoon wsId=ws.id}}
      {{else if summary.upcomingEvents.length}}
      {{else}}
        <p class="text-muted mb-0">Nothing is about to expire. Enjoy it.</p>
      {{/if}}
    </section>
    <section class="card p-3" aria-labelledby="priority-title">
      <h2 class="h5" id="priority-title">Priority tasks</h2>
      {{> task-list tasks=summary.priority empty="No open high-priority tasks." wsId=ws.id}}
    </section>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <section class="card p-3 h-100" aria-labelledby="tasks-title">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h5 mb-0" id="tasks-title">Open tasks <small class="text-muted">({{summary.openTotal}})</small></h2>
        <div class="d-flex gap-2">
          <a class="btn btn-sm btn-outline-primary" href="/admin/workspaces/{{ws.id}}/tasks">All tasks</a>
          <a class="btn btn-sm btn-primary" href="/admin/workspaces/{{ws.id}}/tasks/new">+ New task</a>
        </div>
      </div>
      {{> task-list tasks=summary.openTasks empty="No open tasks. Add one!" wsId=ws.id}}
    </section>
  </div>
  <div class="col-lg-4">
    <section class="card p-3 h-100" aria-labelledby="note-title">
      <h2 class="h5" id="note-title">Quick note</h2>
      {{> quick-note wsId=ws.id}}
      <a class="small mt-2" href="/admin/workspaces/{{ws.id}}/pages">All pages ({{summary.pages}})</a>
    </section>
  </div>
</div>

<script src="/static/calendar.js"></script>
